#!/bin/bash
# Creates 0000000000000000/<TITLE_ID> for every real Xbox 360 GOD title in
# gamelist_xbox360.csv (tab-separated: title_id, media_id, title_name).
# "Real game" = has a non-empty media_id; junk rows (demos, dashboard items,
# XBLA compilation discs, etc.) have a blank media_id and are skipped.
# Run it from anywhere; the folder is created next to this script (not the
# shell's current working directory), and gamelist_xbox360.csv must live in
# that same directory.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$DIR/0000000000000000"
CSV="$DIR/gamelist_xbox360.csv"

if [ ! -f "$CSV" ]; then
    echo "Missing $CSV — this script needs gamelist_xbox360.csv next to it." >&2
    exit 1
fi

mkdir -p "$ROOT"

KEEP_LIST="$(mktemp)"
trap 'rm -f "$KEEP_LIST"' EXIT

# Skip header, keep rows with a non-empty media_id, dedupe title_id.
tail -n +2 "$CSV" | awk -F'\t' '$2 != "" { print $1 }' | sort -u > "$KEEP_LIST"

while IFS= read -r title_id; do
    mkdir -p "$ROOT/$title_id"
done < "$KEEP_LIST"

# Prune empty folders that are no longer in the CSV-derived list.
for dir in "$ROOT"/*/; do
    title_id="$(basename "$dir")"
    if ! grep -qxF "$title_id" "$KEEP_LIST"; then
        if [ -z "$(ls -A "$dir" 2>/dev/null)" ]; then
            rmdir "$dir"
        else
            echo "Skipping non-empty stale folder: $dir" >&2
        fi
    fi
done

echo "Done. Folders under $ROOT/"
echo "Total: $(ls "$ROOT" | wc -l | tr -d ' ') folders"
